# Copy to .env and fill in. .env is gitignored: never commit real values.

# ---- Site ----
# Public hostname. Required for `docker compose --profile tls` (Caddy gets the
# HTTPS certificate for it). Example: paulsolaeniolawun.com
DOMAIN=
# Public base URL, used by PocketBase hooks for absolute links (RSS feed).
# Example: https://paulsolaeniolawun.com
SITE_URL=
# Host port for the nginx web container. Default 8080. With the tls profile,
# bind it to localhost so only Caddy is public: WEB_PORT=127.0.0.1:8080
WEB_PORT=8080

# ---- Cloudflare Tunnel (docker compose --profile tunnel) ----
# Token of a tunnel created in Cloudflare Zero Trust → Networks → Tunnels.
# With the tunnel, nothing needs to be public: set WEB_PORT=127.0.0.1:8080.
TUNNEL_TOKEN=

# ---- Letters (contact form) ----
# Where new letters are emailed. Without it, letters are saved but not emailed.
PAUL_EMAIL=

# ---- SMTP (outgoing mail from PocketBase) ----
# Without SMTP_HOST and SMTP_FROM, no email is sent.
SMTP_HOST=
# 587 (STARTTLS) or 465 (implicit TLS). Default 587.
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Sender address, e.g. no-reply@paulsolaeniolawun.com (must be allowed by your provider).
SMTP_FROM=
# true for implicit TLS (port 465), false for STARTTLS (587). Empty = true only on 465.
SMTP_TLS=

# ---- Seed script only (node seed/seed.mjs); not passed to any container ----
# A record in the `curators` collection (create it in the dashboard at /_/ first).
CURATOR_EMAIL=
CURATOR_PASSWORD=
# PocketBase base URL as seen from where the seed runs.
# From the server host: http://127.0.0.1:8080  (through nginx)
# From a container on the compose network: http://pocketbase:8090
PB_URL=http://127.0.0.1:8080
